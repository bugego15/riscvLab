# U-Boot 实验配置片段：S 模式 + virtio-blk + FAT + 环境变量落盘 + bootcount
# 由 01-boot-chain/03-uboot-s/build-uboot-s.sh 叠加到 qemu-riscv64_smode_defconfig 上

# --- 块设备：QEMU virt 的 virtio-blk（MMIO） ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y

# --- 文件系统与命令 ---
CONFIG_CMD_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_EXT4_WRITE=y
CONFIG_CMD_PART=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_IMPORTENV=y
CONFIG_CMD_EXPORTENV=y
CONFIG_CMD_SETEXPR=y
CONFIG_FAT_WRITE=y
CONFIG_FIT=y

# --- 环境变量保存到 virtio-blk 0:1 的 FAT 分区（关键验证点） ---
# 必须禁用 NOWHERE，否则 env_load 会选中 nowhere，saveenv 无法落盘
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_FAT=y
CONFIG_ENV_FAT_INTERFACE="virtio"
CONFIG_ENV_FAT_DEVICE_AND_PART="0:1"
CONFIG_ENV_FAT_FILE="uboot.env"
CONFIG_ENV_SIZE=0x20000
CONFIG_ENV_RELOC_GD_ENV_ADDR=y

# --- 注意：A/B 的 bootcount/回退逻辑在 boot.scr 里手动实现并持久化到 data 分区，
# --- 因此不启用 U-Boot 自带的 BOOTCOUNT 框架，避免双份计数互相干扰。

# --- 启动流程：加载 FAT 分区上的 boot.scr 并执行 ---
CONFIG_BOOTCOMMAND="setenv scriptaddr 0x8e000000; fatload virtio 0:1 ${scriptaddr} boot.scr; source ${scriptaddr}"
